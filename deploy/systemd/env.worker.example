# Host-side provisioning worker env.
# Copy to .env.worker next to docker-compose.yml — referenced by systemd.
# NEVER commit real passwords.
#
# Deploy path, public IP, and MySQL host/port for provision probes come from
# the job's Server row (servers.deploy_path / public_ip / db_host / db_port).
# Keep MYSQL credentials here — they are not stored on Server.

# Which Server this worker owns (servers.id). Required.
# Caesar: SELECT id FROM servers WHERE name = 'caesar';  → typically 1
MERCATA_SERVER_ID=1

# Loopback MySQL published by mercata_control_db (127.0.0.1:3307 → 3306).
# Do NOT use the docker-compose hostname mercata_control_db from the host.
DATABASE_URL=mysql://mercata_admin:CHANGE_ME@127.0.0.1:3307/mercata_control

# Same AES key as mercata_admin — decrypts one-time provision secret hand-off.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Operator-supplied external secrets file fallback (encrypted DB hand-off preferred).
# Mode 0700 dir, 0600 files. Never commit.
PROVISION_SECRETS_DIR=/var/lib/mercata/provision-secrets

# MySQL credentials used by tenant:provision on the host (CREATE DATABASE privilege).
# Host/port themselves come from Server.db_host / Server.db_port.
PROVISION_MYSQL_USER=root
PROVISION_MYSQL_PASSWORD=CHANGE_ME

# Caesar only — live compose/Caddy/tenants live in ~/caesar/fleet (not {repo}/deploy).
# New boxes that keep artifacts under {deploy_path}/deploy can omit these.
FLEET_DEPLOY_DIR=/home/matthew/caesar/fleet
FLEET_APP_ROOT=/home/matthew/caesar/sites/web

PROVISION_WORKER_POLL_MS=5000
PROVISION_WORKER_STALE_MINUTES=30
PROVISION_HEALTH_TIMEOUT_MS=180000
