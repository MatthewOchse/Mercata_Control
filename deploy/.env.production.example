# Production secrets for ~/caesar/control/.env — never commit the real file.

# MySQL (container-local only)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
MYSQL_USER=mercata_admin

# App
DATABASE_URL=mysql://mercata_admin:change-me-app@mercata_control_db:3306/mercata_control
SESSION_SECRET=
ENCRYPTION_KEY=
APP_URL=https://admin.mercata.co.za
VAT_REGISTERED=false
VAT_NUMBER=

# Operator seed (run once)
OPERATOR_EMAIL=you@mercata.co.za
OPERATOR_PASSWORD=
OPERATOR_NAME=Matthew

# Cron + alerts
CRON_SECRET=
RESEND_API_KEY=
ALERT_EMAIL_TO=you@mercata.co.za
ALERT_EMAIL_FROM=Mercata Control <alerts@mercata.co.za>
INVOICE_EMAIL_FROM=Mercata Billing <billings@mercata.co.za>
# Optional; defaults to the address in INVOICE_EMAIL_FROM
INVOICE_EMAIL_CC=billings@mercata.co.za
DIGEST_EMAIL_FROM=Mercata <digests@mercata.co.za>
DIGEST_UNSUB_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Invoice / banking
MERCATA_LEGAL_NAME=Mercata
MERCATA_ADDRESS=South Africa
BANK_NAME=FNB/RMB
BANK_ACCOUNT_NAME=*Mercata Web
BANK_ACCOUNT_NUMBER=63218852340
BANK_BRANCH_CODE=250655
