# MySQL — create the database first, then point here
DATABASE_URL=mysql://mercata_admin:CHANGE_ME@127.0.0.1:3306/mercata_control

# Cookie signing / session integrity (long random string)
SESSION_SECRET=replace-with-a-long-random-string

# AES key for fleet_secret at rest — required (32 bytes as 64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Public URL of this app
APP_URL=http://localhost:3000

# Locked decision — flip when VAT-registered
VAT_REGISTERED=false

# Optional: Mercata VAT number (only used when VAT_REGISTERED=true)
VAT_NUMBER=

# Seed script
OPERATOR_EMAIL=you@mercata.co.za
OPERATOR_PASSWORD=
OPERATOR_NAME=Matthew

# Invoice PDF / company
MERCATA_LEGAL_NAME=Mercata
MERCATA_ADDRESS=South Africa
BANK_NAME=FNB
BANK_ACCOUNT_NAME=Mercata
BANK_ACCOUNT_NUMBER=0000000000
BANK_BRANCH_CODE=250655

# Fleet health cron (Bearer token for /api/cron/*)
CRON_SECRET=

# Alerts — pluggable channels (configure any combination)
RESEND_API_KEY=
ALERT_EMAIL_TO=you@mercata.co.za
ALERT_EMAIL_FROM=Mercata Control <alerts@mercata.co.za>
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Invoice delivery (PDF email to billing contact)
INVOICE_EMAIL_FROM=Mercata Accounts <accounts@mercata.co.za>

# Customer analytics digests (Resend; same API key as alerts)
DIGEST_EMAIL_FROM=Mercata <digests@mercata.co.za>
# Optional; falls back to SESSION_SECRET for unsubscribe HMAC
DIGEST_UNSUB_SECRET=

# GA4 — single Google service account JSON (viewer on each tenant property)
GOOGLE_SERVICE_ACCOUNT_JSON=
